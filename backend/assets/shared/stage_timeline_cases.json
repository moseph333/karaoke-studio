{
  "about": "Lyric lines and the song's length in, when everything shows out (seconds). show/hide are for looks with a row per line, advance/leave for looks with one reading place. Run by backend/tests/looks/test_stage_timeline_cases.py and the stage's stageTimeline tests.",
  "cases": [
    {"name": "a long intro gets a title card, a break marker and a count-in", "lines": [{"start_time": 20.0, "end_time": 24.0}, {"start_time": 24.5, "end_time": 28.0}], "duration": 60.0, "cues": true, "expect": {"lines": [{"index": 0, "start": 20.0, "end": 24.0, "part": "singer1", "gap": true, "show": 17.5, "hide": 25.2, "advance": 17.5, "leave": 24.0, "label": false}, {"index": 1, "start": 24.5, "end": 28.0, "part": "singer1", "gap": false, "show": 24.0, "hide": 29.2, "advance": 24.0, "leave": 29.2, "label": false}], "title": [0.0, 8.0], "end_card": [29.5, 60.0], "count_ins": [[0, 17.0, 20.0]], "breaks": [[8.5, 17.0, 20.0]], "first_show": 8.5}},
    {"name": "an intro of exactly six seconds still gets the card", "lines": [{"start_time": 6.0, "end_time": 9.0}], "duration": 20.0, "cues": true, "expect": {"lines": [{"index": 0, "start": 6.0, "end": 9.0, "part": "singer1", "gap": true, "show": 3.5, "hide": 10.2, "advance": 3.5, "leave": 10.2, "label": false}], "title": [0.0, 2.5], "end_card": [10.5, 20.0], "count_ins": [[0, 3.0, 6.0]], "breaks": [], "first_show": 3.0}},
    {"name": "an intro just under six seconds gets no card but a count-in", "lines": [{"start_time": 5.9, "end_time": 9.0}], "duration": 20.0, "cues": true, "expect": {"lines": [{"index": 0, "start": 5.9, "end": 9.0, "part": "singer1", "gap": true, "show": 3.4, "hide": 10.2, "advance": 3.4, "leave": 10.2, "label": false}], "title": null, "end_card": [10.5, 20.0], "count_ins": [[0, 2.9, 5.9]], "breaks": [[0.0, 2.9, 5.9]], "first_show": 0.0}},
    {"name": "an intro under the gap threshold gets neither", "lines": [{"start_time": 3.9, "end_time": 7.0}], "duration": 20.0, "cues": true, "expect": {"lines": [{"index": 0, "start": 3.9, "end": 7.0, "part": "singer1", "gap": false, "show": 1.4, "hide": 8.2, "advance": 1.4, "leave": 8.2, "label": false}], "title": null, "end_card": [8.5, 20.0], "count_ins": [], "breaks": [], "first_show": 0.0}},
    {"name": "lines that follow closely take over when the one before ends", "lines": [{"start_time": 1.0, "end_time": 3.0}, {"start_time": 3.2, "end_time": 5.0}, {"start_time": 5.0, "end_time": 7.0}], "duration": 12.0, "cues": true, "expect": {"lines": [{"index": 0, "start": 1.0, "end": 3.0, "part": "singer1", "gap": false, "show": 0.0, "hide": 4.2, "advance": 0.0, "leave": 3.0, "label": false}, {"index": 1, "start": 3.2, "end": 5.0, "part": "singer1", "gap": false, "show": 3.0, "hide": 6.2, "advance": 3.0, "leave": 5.0, "label": false}, {"index": 2, "start": 5.0, "end": 7.0, "part": "singer1", "gap": false, "show": 3.0, "hide": 8.2, "advance": 5.0, "leave": 8.2, "label": false}], "title": null, "end_card": [8.5, 12.0], "count_ins": [], "breaks": [], "first_show": 0.0}},
    {"name": "a line that starts before the one before ends takes over at its own start", "lines": [{"start_time": 1.0, "end_time": 4.0}, {"start_time": 3.0, "end_time": 6.0}], "duration": 10.0, "cues": true, "expect": {"lines": [{"index": 0, "start": 1.0, "end": 4.0, "part": "singer1", "gap": false, "show": 0.0, "hide": 5.2, "advance": 0.0, "leave": 3.0, "label": false}, {"index": 1, "start": 3.0, "end": 6.0, "part": "singer1", "gap": false, "show": 1.0, "hide": 7.2, "advance": 3.0, "leave": 7.2, "label": false}], "title": null, "end_card": null, "count_ins": [], "breaks": [], "first_show": 0.0}},
    {"name": "a break of four seconds or more gets a marker and a count-in", "lines": [{"start_time": 1.0, "end_time": 3.0}, {"start_time": 12.0, "end_time": 15.0}], "duration": 30.0, "cues": true, "expect": {"lines": [{"index": 0, "start": 1.0, "end": 3.0, "part": "singer1", "gap": false, "show": 0.0, "hide": 4.2, "advance": 0.0, "leave": 4.2, "label": false}, {"index": 1, "start": 12.0, "end": 15.0, "part": "singer1", "gap": true, "show": 10.0, "hide": 16.2, "advance": 10.0, "leave": 16.2, "label": false}], "title": null, "end_card": [16.5, 30.0], "count_ins": [[1, 9.0, 12.0]], "breaks": [[4.5, 9.0, 12.0]], "first_show": 0.0}},
    {"name": "a break just under four seconds gets none", "lines": [{"start_time": 1.0, "end_time": 3.0}, {"start_time": 6.99, "end_time": 9.0}], "duration": 30.0, "cues": true, "expect": {"lines": [{"index": 0, "start": 1.0, "end": 3.0, "part": "singer1", "gap": false, "show": 0.0, "hide": 4.2, "advance": 0.0, "leave": 4.2, "label": false}, {"index": 1, "start": 6.99, "end": 9.0, "part": "singer1", "gap": false, "show": 4.99, "hide": 10.2, "advance": 4.99, "leave": 10.2, "label": false}], "title": null, "end_card": [10.5, 30.0], "count_ins": [], "breaks": [], "first_show": 0.0}},
    {"name": "a break too short for its marker still gets the count-in", "lines": [{"start_time": 1.0, "end_time": 3.0}, {"start_time": 8.0, "end_time": 10.0}], "duration": 30.0, "cues": true, "expect": {"lines": [{"index": 0, "start": 1.0, "end": 3.0, "part": "singer1", "gap": false, "show": 0.0, "hide": 4.2, "advance": 0.0, "leave": 4.2, "label": false}, {"index": 1, "start": 8.0, "end": 10.0, "part": "singer1", "gap": true, "show": 6.0, "hide": 11.2, "advance": 6.0, "leave": 11.2, "label": false}], "title": null, "end_card": [11.5, 30.0], "count_ins": [[1, 5.0, 8.0]], "breaks": [], "first_show": 0.0}},
    {"name": "the end card needs three seconds after the last line", "lines": [{"start_time": 1.0, "end_time": 3.0}], "duration": 7.5, "cues": true, "expect": {"lines": [{"index": 0, "start": 1.0, "end": 3.0, "part": "singer1", "gap": false, "show": 0.0, "hide": 4.2, "advance": 0.0, "leave": 4.2, "label": false}], "title": null, "end_card": [4.5, 7.5], "count_ins": [], "breaks": [], "first_show": 0.0}},
    {"name": "no end card when the song ends sooner", "lines": [{"start_time": 1.0, "end_time": 3.0}], "duration": 7.4, "cues": true, "expect": {"lines": [{"index": 0, "start": 1.0, "end": 3.0, "part": "singer1", "gap": false, "show": 0.0, "hide": 4.2, "advance": 0.0, "leave": 4.2, "label": false}], "title": null, "end_card": null, "count_ins": [], "breaks": [], "first_show": 0.0}},
    {"name": "no end card without the song's length", "lines": [{"start_time": 1.0, "end_time": 3.0}], "duration": null, "cues": true, "expect": {"lines": [{"index": 0, "start": 1.0, "end": 3.0, "part": "singer1", "gap": false, "show": 0.0, "hide": 4.2, "advance": 0.0, "leave": 4.2, "label": false}], "title": null, "end_card": null, "count_ins": [], "breaks": [], "first_show": 0.0}},
    {"name": "cues off: no count-ins or break markers, the cards stay", "lines": [{"start_time": 20.0, "end_time": 24.0}, {"start_time": 40.0, "end_time": 44.0}], "duration": 60.0, "cues": false, "expect": {"lines": [{"index": 0, "start": 20.0, "end": 24.0, "part": "singer1", "gap": true, "show": 17.5, "hide": 25.2, "advance": 17.5, "leave": 25.2, "label": false}, {"index": 1, "start": 40.0, "end": 44.0, "part": "singer1", "gap": true, "show": 38.0, "hide": 45.2, "advance": 38.0, "leave": 45.2, "label": false}], "title": [0.0, 8.0], "end_card": [45.5, 60.0], "count_ins": [], "breaks": [], "first_show": 8.5}},
    {"name": "a part name shows where the singer changes", "lines": [{"start_time": 1.0, "end_time": 3.0}, {"start_time": 3.5, "end_time": 5.0, "singer": "singer2"}, {"start_time": 5.5, "end_time": 7.0, "singer": "Singer 2"}, {"start_time": 7.5, "end_time": 9.0, "singer": "both"}, {"start_time": 9.5, "end_time": 11.0}], "duration": 20.0, "cues": true, "expect": {"lines": [{"index": 0, "start": 1.0, "end": 3.0, "part": "singer1", "gap": false, "show": 0.0, "hide": 4.2, "advance": 0.0, "leave": 3.0, "label": true}, {"index": 1, "start": 3.5, "end": 5.0, "part": "singer2", "gap": false, "show": 3.0, "hide": 6.2, "advance": 3.0, "leave": 5.0, "label": true}, {"index": 2, "start": 5.5, "end": 7.0, "part": "singer2", "gap": false, "show": 5.0, "hide": 8.2, "advance": 5.0, "leave": 7.0, "label": false}, {"index": 3, "start": 7.5, "end": 9.0, "part": "both", "gap": false, "show": 7.0, "hide": 10.2, "advance": 7.0, "leave": 9.0, "label": true}, {"index": 4, "start": 9.5, "end": 11.0, "part": "singer1", "gap": false, "show": 9.0, "hide": 12.2, "advance": 9.0, "leave": 12.2, "label": true}], "title": null, "end_card": [12.5, 20.0], "count_ins": [], "breaks": [], "first_show": 0.0}},
    {"name": "one part: no part names", "lines": [{"start_time": 1.0, "end_time": 3.0}, {"start_time": 3.5, "end_time": 5.0, "singer": "lead"}], "duration": 20.0, "cues": true, "expect": {"lines": [{"index": 0, "start": 1.0, "end": 3.0, "part": "singer1", "gap": false, "show": 0.0, "hide": 4.2, "advance": 0.0, "leave": 3.0, "label": false}, {"index": 1, "start": 3.5, "end": 5.0, "part": "singer1", "gap": false, "show": 3.0, "hide": 6.2, "advance": 3.0, "leave": 6.2, "label": false}], "title": null, "end_card": [6.5, 20.0], "count_ins": [], "breaks": [], "first_show": 0.0}},
    {"name": "entries that are not lines are skipped but keep their index", "lines": [null, {"start_time": 1.0, "end_time": 3.0}, "x", {"start_time": 3.5, "end_time": 5.0}], "duration": 20.0, "cues": true, "expect": {"lines": [{"index": 1, "start": 1.0, "end": 3.0, "part": "singer1", "gap": false, "show": 0.0, "hide": 4.2, "advance": 0.0, "leave": 3.0, "label": false}, {"index": 3, "start": 3.5, "end": 5.0, "part": "singer1", "gap": false, "show": 3.0, "hide": 6.2, "advance": 3.0, "leave": 6.2, "label": false}], "title": null, "end_card": [6.5, 20.0], "count_ins": [], "breaks": [], "first_show": 0.0}},
    {"name": "a line without times starts at 0 and lasts four seconds", "lines": [{"text": "untimed"}], "duration": 20.0, "cues": true, "expect": {"lines": [{"index": 0, "start": 0.0, "end": 4.0, "part": "singer1", "gap": false, "show": 0.0, "hide": 5.2, "advance": 0.0, "leave": 5.2, "label": false}], "title": null, "end_card": [5.5, 20.0], "count_ins": [], "breaks": [], "first_show": 0.0}},
    {"name": "times are rounded to the centisecond", "lines": [{"start_time": 1.005, "end_time": 3.333}, {"start_time": 3.337, "end_time": 5.001}], "duration": 12.0, "cues": true, "expect": {"lines": [{"index": 0, "start": 1.005, "end": 3.333, "part": "singer1", "gap": false, "show": 0.0, "hide": 4.53, "advance": 0.0, "leave": 3.33, "label": false}, {"index": 1, "start": 3.337, "end": 5.001, "part": "singer1", "gap": false, "show": 3.33, "hide": 6.2, "advance": 3.33, "leave": 6.2, "label": false}], "title": null, "end_card": [6.5, 12.0], "count_ins": [], "breaks": [], "first_show": 0.0}},
    {"name": "no lines", "lines": [], "duration": 20.0, "cues": true, "expect": {"lines": [], "title": null, "end_card": null, "count_ins": [], "breaks": [], "first_show": 0.0}}
  ]
}
