# ==============================================================================
# YouTube Karaoke Studio - Environment Configuration
# ==============================================================================

# Port the FastAPI server listens on inside the container / host
PORT=8000

# Shared passphrase required by friends to access the studio.
# Leave empty to disable authentication (open access).
APP_PASSWORD=singalong2026

# Cloudflare Tunnel connector token (from Cloudflare Zero Trust dashboard).
# If provided, the cloudflared service in docker-compose will automatically route
# your custom domain (e.g. karaoke.yourdomain.com) to this container.
# Leave blank if you use an existing reverse proxy (Caddy / Nginx / NPM).
CLOUDFLARE_TUNNEL_TOKEN=

# Directory for persisting project data, audio stems, and exported videos.
# Inside Docker, this maps to /app/workspace_data.
KARAOKE_DATA_DIR=./workspace_data
