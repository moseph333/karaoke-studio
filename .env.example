# ==============================================================================
# YouTube Karaoke Studio - Environment Configuration
# ==============================================================================

# Port the FastAPI server listens on inside the container / host
PORT=8000

# Shared passphrase required by users to access the studio.
# Leave empty to disable authentication (open access), or set a secure passphrase.
# When set, /api/auth/login issues an HMAC-SHA256 signed session token and HttpOnly cookie.
APP_PASSWORD=

# Sliding-window login rate limiting per client IP
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60.0

# Maximum concurrent audio processing and video rendering jobs (excess jobs remain queued)
MAX_CONCURRENT_JOBS=2

# Cloudflare Tunnel connector token (from Cloudflare Zero Trust dashboard).
# If provided, the cloudflared service in docker-compose will automatically route
# your custom domain (e.g. karaoke.yourdomain.com) to this container.
# Leave blank if you use an existing reverse proxy (Caddy / Nginx / NPM).
CLOUDFLARE_TUNNEL_TOKEN=

# Directory for persisting project data, audio stems, and exported videos.
# Inside Docker, this maps to /app/workspace_data.
KARAOKE_DATA_DIR=./workspace_data

# ==============================================================================
# Stem separation quality
# ==============================================================================

# Default quality for new songs (each song can still pick its own in Advanced options):
#   fast      Demucs htdemucs. Bundled, quickest on CPU (about 1/3 of the song's length).
#   balanced  Mel-Band RoFormer: cleaner vocals with less instrument bleed (about 1.6x the
#             song's length on CPU).
#   best      Mel-Band RoFormer + BS-RoFormer averaged: cleanest, slowest (GPU recommended).
# Balanced and Best need the optional ML extras (backend/requirements-ml.txt, installed in
# the Docker image unless INSTALL_ML_EXTRAS=0). When a preset cannot run, separation falls
# back best -> balanced -> fast automatically and the studio shows why.
SEPARATION_QUALITY=balanced

# Download RoFormer weights on first use (roughly 0.6-0.9 GB per model) into
# AUDIO_SEPARATOR_MODEL_DIR. Set to 0 on offline servers after prefetching them with
#   python -m backend.tools.fetch_models --separation all
# The weights are third-party files with their own licences; review them before
# commercial use.
SEPARATION_ALLOW_DOWNLOAD=1

# Where RoFormer weights are kept (Docker: /models/audio-separator in the models volume;
# otherwise <KARAOKE_DATA_DIR>/models/audio-separator)
# AUDIO_SEPARATOR_MODEL_DIR=

# Override the RoFormer checkpoints (audio-separator model file names)
# SEPARATION_BALANCED_MODEL=vocals_mel_band_roformer.ckpt
# SEPARATION_BEST_MODELS=vocals_mel_band_roformer.ckpt,model_bs_roformer_ep_317_sdr_12.9755.ckpt

# Stop a separation that runs longer than SEPARATION_TIMEOUT_SEC, or that prints nothing
# for SEPARATION_STALL_SEC (both in seconds)
SEPARATION_TIMEOUT_SEC=7200
SEPARATION_STALL_SEC=900

# Docker build: 0 skips the optional ML extras for a smaller image (Fast only)
INSTALL_ML_EXTRAS=1

# Local installs (run.sh): PyTorch wheel index. The default CPU build is smaller; use e.g.
# https://download.pytorch.org/whl/cu128 for an NVIDIA GPU.
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
